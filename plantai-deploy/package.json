{
  "name": "plantai",
  "version": "1.0.0",
  "private": true,
  "description": "PlantAI - Ургамлын өвчин оношлогоо & Хөрсний AI шинжилгээ",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"tests/*.test.mjs\"",
    "android:sync": "vite build && cap sync android",
    "android:apk": "npm run android:sync && cd android && .\\gradlew.bat assembleDebug",
    "android:aab": "npm run android:sync && cd android && .\\gradlew.bat bundleRelease",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.3",
    "@vercel/blob": "^2.6.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0"
  }
}
